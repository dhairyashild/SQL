२. अद्ययावत कॉलम नावांसह मास्टर कमांड (Updated Naming Master Query):
   या क्वेरीमध्ये तुमच्या मागणीनुसार आधी 'Part' गट आणि नंतर 'Global' गट अशी मांडणी ठेवून, आउटपुट कॉलम्सची नावे सुटसुटीत (Part_Sum, Global_Sum) केली आहेत.
   कमांड:
   SELECT new_id, new_cat,
          -- १. पार्टीशन विंडो (कॅटेगरीनुसार स्वतंत्र गणिते)
          SUM(new_id)   OVER(PARTITION BY new_cat ORDER BY new_id) AS "Part_Sum",
          AVG(new_id)   OVER(PARTITION BY new_cat ORDER BY new_id) AS "Part_Avg",
          COUNT(new_id) OVER(PARTITION BY new_cat ORDER BY new_id) AS "Part_Count",
          MIN(new_id)   OVER(PARTITION BY new_cat ORDER BY new_id) AS "Part_Min",
          MAX(new_id)   OVER(PARTITION BY new_cat ORDER BY new_id) AS "Part_Max",

          -- २. ग्लोबल विंडो (संपूर्ण टेबलची एकत्र गणिते - UNBOUNDED)
          SUM(new_id)   OVER(ORDER BY new_id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS "Global_Sum",
          AVG(new_id)   OVER(ORDER BY new_id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS "Global_Avg",
          COUNT(new_id) OVER(ORDER BY new_id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS "Global_Count",
          MIN(new_id)   OVER(ORDER BY new_id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS "Global_Min",
          MAX(new_id)   OVER(ORDER BY new_id ROWS BETWEEN UNBOUNDED PRECEDING AND UNBOUNDED FOLLOWING) AS "Global_Max"
   FROM test_data;

