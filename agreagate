-- TABLE: sales
-- id | product  | amount
-- 1  | Laptop   | 50000
-- 2  | Mouse    | 500
-- 3  | Chair    | 3000

-- MIN - smallest value
SELECT MIN(amount) FROM sales;  -- 500

-- MAX - largest value  
SELECT MAX(amount) FROM sales;  -- 50000

-- AVG - average value
SELECT AVG(amount) FROM sales;  -- 17833.33

-- SUM - total value
SELECT SUM(amount) FROM sales;  -- 53500

-- COUNT - number of rows
SELECT COUNT(*) FROM sales;     -- 3

-- GROUP BY - group then aggregate
SELECT product, SUM(amount) FROM sales GROUP BY product;

-- Output:
-- product  | SUM(amount)
-- Laptop   | 50000
-- Mouse    | 500
-- Chair    | 3000

-- HAVING - filter groups
SELECT product, SUM(amount) FROM sales GROUP BY product HAVING SUM(amount) > 1000;

-- Output:
-- product  | SUM(amount)
-- Laptop   | 50000
-- Chair    | 3000
