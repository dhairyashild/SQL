
┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 1: BASIC SELECT                                                     │
│ QUESTION: "Show all employees"                                              │
│ QUERY: SELECT * FROM employees;                                             │
│ NOTE: * means all columns. Use this to explore your table first.           │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 2: SELECT SPECIFIC COLUMNS                                          │
│ QUESTION: "Show only employee names and salaries"                           │
│ QUERY: SELECT emp_name, salary FROM employees;                              │
│ NOTE: Only listed columns appear. Faster than SELECT * for large tables.   │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 3: WHERE (Row Filtering)                                            │
│ QUESTION: "Find employees in IT department"                                 │
│ QUERY: SELECT * FROM employees WHERE dept = 'IT';                           │
│ NOTE: WHERE filters rows BEFORE grouping. String values need quotes ''.    │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 4: WHERE with AND (Multiple conditions)                             │
│ QUESTION: "Find IT employees in New York"                                   │
│ QUERY: SELECT * FROM employees WHERE dept = 'IT' AND location = 'New York'; │
│ NOTE: AND means ALL conditions must be TRUE. Both conditions apply.        │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 5: WHERE with OR (Either condition)                                 │
│ QUESTION: "Find employees in IT or Sales department"                        │
│ QUERY: SELECT * FROM employees WHERE dept = 'IT' OR dept = 'Sales';         │
│ NOTE: OR means AT LEAST ONE condition must be TRUE. Use parentheses for     │
│       mixing AND and OR.                                                    │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 6: ORDER BY (Sorting)                                               │
│ QUESTION: "Show all employees sorted by highest salary"                     │
│ QUERY: SELECT emp_name, salary FROM employees ORDER BY salary DESC;         │
│ NOTE: DESC = highest to lowest. ASC = lowest to highest (default).          │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 7: ORDER BY + LIMIT (Top N)                                         │
│ QUESTION: "Show top 3 highest paid employees"                               │
│ QUERY: SELECT emp_name, salary FROM employees ORDER BY salary DESC LIMIT 3; │
│ NOTE: LIMIT restricts number of rows returned. Always use with ORDER BY    │
│       for meaningful "top N" results.                                       │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 8: GROUP BY (Count per category)                                    │
│ QUESTION: "Count how many employees in each department"                     │
│ QUERY: SELECT dept, COUNT(*) AS employee_count FROM employees GROUP BY dept;│
│ NOTE: GROUP BY collapses rows into unique categories. COUNT(*) counts rows │
│       per group.                                                            │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 9: GROUP BY with SUM (Total per group)                              │
│ QUESTION: "Total salary paid to each department"                            │
│ QUERY: SELECT dept, SUM(salary) AS total_salary FROM employees GROUP BY dept;│
│ NOTE: SUM adds up all values in a column per group. Other aggregates:      │
│       AVG, MIN, MAX.                                                        │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 10: GROUP BY with AVG (Average per group)                           │
│ QUESTION: "Average salary by location"                                      │
│ QUERY: SELECT location, AVG(salary) AS avg_salary FROM employees GROUP BY location;│
│ NOTE: AVG ignores NULL values automatically. Use ROUND(AVG(salary),2) for  │
│       decimal places.                                                       │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 11: HAVING (Filter groups after GROUP BY)                           │
│ QUESTION: "Find departments with average salary above $70,000"              │
│ QUERY: SELECT dept, AVG(salary) AS avg_salary FROM employees GROUP BY dept  │
│        HAVING AVG(salary) > 70000;                                          │
│ NOTE: HAVING filters groups (after GROUP BY). WHERE filters rows (before    │
│       GROUP BY). Cannot use HAVING without GROUP BY.                        │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 12: DISTINCT (Remove duplicates)                                    │
│ QUESTION: "List all unique department names"                                │
│ QUERY: SELECT DISTINCT dept FROM employees;                                 │
│ NOTE: DISTINCT removes duplicate rows. For multiple columns, combination   │
│       must be unique.                                                       │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 13: WHERE with Comparison Operators                                 │
│ QUESTION: "Find employees earning more than $70,000"                        │
│ QUERY: SELECT emp_name, salary FROM employees WHERE salary > 70000;         │
│ NOTE: Comparison operators: >, <, >=, <=, =, <>(not equal). Always use     │
│       quotes for strings, no quotes for numbers.                            │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 14: WHERE with BETWEEN                                              │
│ QUESTION: "Find employees with salary between $50,000 and $70,000"          │
│ QUERY: SELECT emp_name, salary FROM employees WHERE salary BETWEEN 50000 AND 70000;│
│ NOTE: BETWEEN is inclusive (includes boundary values). Alternative:         │
│       salary >= 50000 AND salary <= 70000.                                  │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 15: WHERE with IN                                                   │
│ QUESTION: "Find employees in HR or Marketing departments"                   │
│ QUERY: SELECT * FROM employees WHERE dept IN ('HR', 'Marketing');           │
│ NOTE: IN is cleaner than multiple OR conditions. Can also use NOT IN.      │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 16: WHERE with LIKE (Pattern matching)                              │
│ QUESTION: "Find employees whose name starts with 'A'"                       │
│ QUERY: SELECT emp_name FROM employees WHERE emp_name LIKE 'A%';             │
│ NOTE: % = any characters (including zero). _ = exactly one character.      │
│       LIKE is case-sensitive in some databases.                             │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 17: ORDER BY Multiple Columns                                       │
│ QUESTION: "Sort by department then by salary (highest first)"               │
│ QUERY: SELECT emp_name, dept, salary FROM employees ORDER BY dept ASC, salary DESC;│
│ NOTE: First sorts by dept A-Z, then within each dept sorts by salary        │
│       highest to lowest.                                                    │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 18: COUNT with WHERE                                                │
│ QUESTION: "How many employees work in Chicago?"                             │
│ QUERY: SELECT COUNT(*) AS chicago_employees FROM employees WHERE location = 'Chicago';│
│ NOTE: COUNT(*) counts rows. COUNT(column) counts non-NULL values. Use      │
│       WHERE to filter before counting.                                      │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 19: MIN and MAX                                                     │
│ QUESTION: "What is the highest and lowest salary in the company?"           │
│ QUERY: SELECT MAX(salary) AS highest_salary, MIN(salary) AS lowest_salary FROM employees;│
│ NOTE: MIN/MAX work on numbers, dates, and strings. NULL values are ignored.│
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 20: GROUP BY with COUNT and HAVING                                  │
│ QUESTION: "Find departments with more than 2 employees"                     │
│ QUERY: SELECT dept, COUNT(*) AS emp_count FROM employees GROUP BY dept HAVING COUNT(*) > 2;│
│ NOTE: COUNT(*) > 2 filters groups. HAVING applies after GROUP BY.           │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 21: UPDATE (Modifying existing data)                                │
│ QUESTION: "Give all IT employees a 10% salary increase"                     │
│ QUERY: UPDATE employees SET salary = salary * 1.10 WHERE dept = 'IT';       │
│ NOTE: ⚠️ ALWAYS use WHERE with UPDATE. Test with SELECT first.              │
│       Without WHERE, EVERY row updates!                                     │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 22: DELETE (Removing specific rows)                                 │
│ QUESTION: "Remove employee with ID 112"                                     │
│ QUERY: DELETE FROM employees WHERE emp_id = 112;                            │
│ NOTE: ⚠️ ALWAYS use WHERE with DELETE. Test with SELECT first.              │
│       Without WHERE, ALL rows are deleted!                                  │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 23: ALIASING (Renaming columns for readability)                     │
│ QUESTION: "Show employee names as 'Staff Name' and locations as 'City'"     │
│ QUERY: SELECT emp_name AS "Staff Name", location AS "City" FROM employees;  │
│ NOTE: AS is optional but recommended. Use double quotes for names with     │
│       spaces. Aliases only exist for that query.                            │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 24: CALCULATED COLUMNS (Math in SELECT)                             │
│ QUESTION: "Show each employee's salary and a 10% bonus amount"              │
│ QUERY: SELECT emp_name, salary, (salary * 0.10) AS bonus_amount FROM employees;│
│ NOTE: You can do +, -, *, / in SELECT. Column alias makes output readable. │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 25: HANDLING NULLs (Data Quality)                                   │
│ QUESTION: "Find employees with no department assigned"                      │
│ QUERY: SELECT * FROM employees WHERE dept IS NULL;                          │
│ NOTE: NULL is NOT equal to anything, not even NULL. Use IS NULL or         │
│       IS NOT NULL. Never use = NULL or != NULL.                             │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 26: COALESCE (Replace NULL with default value)                      │
│ QUESTION: "Show all employees with department, replacing NULL with 'Unassigned'"│
│ QUERY: SELECT emp_name, COALESCE(dept, 'Unassigned') AS department FROM employees;│
│ NOTE: COALESCE returns the first non-NULL value. Can have multiple args.   │
│       Great for reports and data cleaning.                                  │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 27: STRING MANIPULATION (Data Cleaning)                             │
│ QUESTION: "Convert employee names to UPPERCASE and create location code"    │
│ QUERY: SELECT UPPER(emp_name) AS upper_name, SUBSTR(location, 1, 3) AS loc_code FROM employees;│
│ NOTE: Functions vary by database: UPPER/LOWER, SUBSTR/SUBSTRING, LENGTH,   │
│       TRIM, REPLACE. Useful for standardizing text data.                    │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 28: CASE STATEMENTS (Conditional Logic)                             │
│ QUESTION: "Categorize employees into pay grades based on salary"            │
│ QUERY: SELECT emp_name, salary, CASE WHEN salary > 80000 THEN 'Senior'      │
│        WHEN salary > 60000 THEN 'Mid' ELSE 'Junior' END AS pay_grade        │
│        FROM employees;                                                      │
│ NOTE: CASE evaluates in order - first TRUE condition wins. Always include  │
│       ELSE for values that don't match any condition.                       │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 29: DATA TYPE CASTING (Converting between types)                    │
│ QUESTION: "Create a unique string by combining emp_id and emp_name"         │
│ QUERY: SELECT CAST(emp_id AS VARCHAR) || '-' || emp_name AS unique_string FROM employees;│
│ NOTE: || is concatenation. CAST converts data types. Alternative:          │
│       emp_id::VARCHAR in PostgreSQL. Use CONCAT() in MySQL.                 │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 30: AGGREGATE FUNCTIONS with NULL handling                          │
│ QUESTION: "Get salary statistics (COUNT ignores NULLs by default)"          │
│ QUERY: SELECT COUNT(salary) AS salaried_emps, AVG(salary) AS avg_sal,       │
│        SUM(salary) AS total_sal FROM employees;                             │
│ NOTE: COUNT(*) counts rows, COUNT(column) counts non-NULL values. AVG and  │
│       SUM ignore NULLs automatically. Use COUNT(*) for total row count.    │
└─────────────────────────────────────────────────────────────────────────────┘


