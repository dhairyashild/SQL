┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 31: INNER JOIN (Only matching rows)                                 │
│ QUESTION: "Show employees with their department budget"                     │
│ QUERY: SELECT e.emp_name, e.dept, d.budget FROM employees e                 │
│        INNER JOIN departments d ON e.dept = d.dept_name;                    │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 32: LEFT JOIN (All rows from employees)                             │
│ QUESTION: "Show all employees with department budget"                       │
│ QUERY: SELECT e.emp_name, e.dept, d.budget FROM employees e                 │
│        LEFT JOIN departments d ON e.dept = d.dept_name;                     │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 33: LEFT JOIN (Show departments even with no employees)             │
│ QUESTION: "Show all departments and any employees in them"                  │
│ QUERY: SELECT d.dept_name, e.emp_name FROM departments d                    │
│        LEFT JOIN employees e ON d.dept_name = e.dept;                       │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 34: RIGHT JOIN (All rows from right table)                          │
│ QUESTION: "Show all departments and their employees"                        │
│ QUERY: SELECT d.dept_name, e.emp_name FROM employees e                      │
│        RIGHT JOIN departments d ON e.dept = d.dept_name;                    │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 35: FIND MISSING (Employees with no matching department)            │
│ QUESTION: "Find employees whose department doesn't exist"                   │
│ QUERY: SELECT e.emp_name, e.dept FROM employees e                           │
│        LEFT JOIN departments d ON e.dept = d.dept_name                      │
│        WHERE d.dept_id IS NULL;                                             │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 36: FIND MISSING (Departments with no employees)                    │
│ QUESTION: "Find departments with no employees assigned"                     │
│ QUERY: SELECT d.dept_name FROM departments d                                │
│        LEFT JOIN employees e ON d.dept_name = e.dept                        │
│        WHERE e.emp_id IS NULL;                                              │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 37: JOIN with AGGREGATION (Count per department)                    │
│ QUESTION: "Count employees in each department (including those with 0)"     │
│ QUERY: SELECT d.dept_name, COUNT(e.emp_id) AS emp_count                     │
│        FROM departments d LEFT JOIN employees e ON d.dept_name = e.dept     │
│        GROUP BY d.dept_name;                                                │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 38: JOIN with SUM (Total salary per department)                     │
│ QUESTION: "Total salary cost by department"                                 │
│ QUERY: SELECT d.dept_name, COALESCE(SUM(e.salary), 0) AS total_salary       │
│        FROM departments d LEFT JOIN employees e ON d.dept_name = e.dept     │
│        GROUP BY d.dept_name;                                                │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 39: SELF JOIN (Join table to itself)                                │
│ QUESTION: "Find employees who work in the same department"                  │
│ QUERY: SELECT e1.emp_name AS employee, e2.emp_name AS colleague, e1.dept    │
│        FROM employees e1 INNER JOIN employees e2 ON e1.dept = e2.dept       │
│        WHERE e1.emp_id < e2.emp_id ORDER BY e1.dept;                        │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 40: MULTIPLE JOINS (3+ tables)                                      │
│ QUESTION: "Show employee, department budget, and manager name"              │
│ QUERY: SELECT e.emp_name, d.dept_name, d.budget, m.emp_name AS manager_name │
│        FROM employees e                                                     │
│        INNER JOIN departments d ON e.dept = d.dept_name                     │
│        LEFT JOIN employees m ON d.manager_id = m.emp_id;                    │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 41: FULL OUTER JOIN                                                 │
│ QUESTION: "Show ALL employees and ALL departments"                          │
│ QUERY: SELECT e.emp_name, e.dept, d.dept_name, d.budget                     │
│        FROM employees e FULL OUTER JOIN departments d ON e.dept = d.dept_name;│
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 42: CROSS JOIN                                                      │
│ QUESTION: "Generate all department-location combinations"                   │
│ QUERY: SELECT d.dept_name, l.location FROM departments d                    │
│        CROSS JOIN (SELECT DISTINCT location FROM employees) l;              │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 43: NON-EQUI JOIN                                                   │
│ QUESTION: "Find higher-paid colleagues in same department"                  │
│ QUERY: SELECT e1.emp_name, e1.salary, e2.emp_name AS higher_paid, e2.salary │
│        FROM employees e1 INNER JOIN employees e2                            │
│        ON e1.dept = e2.dept AND e1.salary < e2.salary;                      │
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 44: ANTI-JOIN using NOT EXISTS                                      │
│ QUESTION: "Find departments with no employees (using NOT EXISTS)"           │
│ QUERY: SELECT d.dept_name FROM departments d                                │
│        WHERE NOT EXISTS (SELECT 1 FROM employees e WHERE e.dept = d.dept_name);│
└─────────────────────────────────────────────────────────────────────────────┘

┌─────────────────────────────────────────────────────────────────────────────┐
│ PATTERN 45: PRE-AGGREGATE before JOIN (Prevent fan-out)                     │
│ QUESTION: "Show department budget vs total employee salary (safely)"        │
│ QUERY: SELECT d.dept_name, d.budget, emp_stats.total_salary                 │
│        FROM departments d LEFT JOIN (                                       │
│            SELECT dept, SUM(salary) AS total_salary                         │
│            FROM employees GROUP BY dept                                     │
│        ) emp_stats ON d.dept_name = emp_stats.dept;                         │
└─────────────────────────────────────────────────────────────────────────────┘

