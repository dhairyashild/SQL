-- AGGREGATE WORKS ONLY ON NUMBERS
SELECT MIN(amount) FROM sales;  -- 500
SELECT MAX(amount) FROM sales;  -- 50000
SELECT AVG(amount) FROM sales;  -- 17833.33
SELECT SUM(amount) FROM sales;  -- 53500
SELECT COUNT(*) FROM sales;     -- 3
SELECT product, SUM(amount) FROM sales GROUP BY product;


select city, count(*) from sales group by(city); -- Column मधील प्रत्येक शब्द किती वेळा पुन्हा आला आहे?


कोणत्याही विशिष्ट COLUMN नुसार दुसऱ्या COLUMN मधील एकूण रकमेची (Total Amount) बेरीज गटनिहाय मिळवण्यासाठी हे कमांड वापरतात.
select city, SUM(amount) from sales group by(city);

ोणत्याही विशिष्ट COLUMN नुसार गट (Group) करून, ज्या COLUMN ची सरासरी (Average) एका ठराविक मूल्यापेक्षा 
(Value) जास्त आहे, फक्त असाच डेटा फिल्टर करून मिळवण्यासाठी हे कमांड वापरतात.
SELECT city, AVG(amount) FROM sales_table GROUP BY city HAVING AVG(amount) > 20000;
