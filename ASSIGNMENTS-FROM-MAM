-- Q1. Find the total parking revenue collected per parking zone.
select parking_zone,sum(parking_fee) from ps group by parking_zone;

-- Q2. Calculate the average parking fee for each vehicle type.
select vehicle_type,avg(parking_fee) from ps group  by vehicle_type;

-- Q3. Identify the maximum parking fee charged in each zone.

select parking_zone,max(parking_fee) from ps group by parking_zone;



-- Q4. Count how many vehicles parked in each zone.
select parking_zone, count(*) from ps group by parking_zone;




-- Q5. Display parking zones where average parking fee is greater than 100.

select parking_zone,avg(parking_fee) from ps group by parking_zone having avg(parking_fee)>100;


